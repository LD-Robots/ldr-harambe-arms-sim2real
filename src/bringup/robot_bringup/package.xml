<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robot_bringup</name>
  <version>0.1.0</version>
  <description>
    Bring-up for the PVT (CiA 402 mode 5) control stack on the full humanoid (25 joints).
    Ships the per-joint ethercat_pvt/ slave configs (source of truth — bootstrapped
    once from arm_real_bringup/config/ethercat/ via scripts/generate_ethercat_pvt.py,
    then hand-tuned) and launches robot_pvt_controller + robot_safety_supervisor +
    drive_status / filtered joint-state broadcasters.
  </description>
  <maintainer email="andrei.dragomir@ldrobots.ro">Andrei Dragomir</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <!-- Run-time stack: controllers, safety, drivers. -->
  <exec_depend>robot_pvt_control</exec_depend>
  <exec_depend>robot_safety</exec_depend>
  <exec_depend>robot_drive_status_broadcaster</exec_depend>
  <exec_depend>robot_filtered_joint_state_broadcaster</exec_depend>
  <exec_depend>ethercat_driver</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>dual_arm_description</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
