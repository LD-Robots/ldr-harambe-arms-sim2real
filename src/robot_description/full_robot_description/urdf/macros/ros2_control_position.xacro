<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="full_robot_ros2_control_position">
    <ros2_control name="harambe_ros2_control" type="system">
      <hardware>
        <plugin>gz_ros2_control/GazeboSimSystem</plugin>
      </hardware>

      <!-- === BODY (waist) === -->
      <joint name="waist_yaw_joint_X8">
        <command_interface name="position">
          <param name="min">-2.60054</param>
          <param name="max">2.60054</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity" />
        <state_interface name="effort" />
      </joint>

      <!-- === LEFT ARM === -->
      <joint name="left_shoulder_pitch_joint_X6">
        <command_interface name="position">
          <param name="min">-3.01942</param>
          <param name="max">1.69297</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity" />
        <state_interface name="effort" />
      </joint>

      <joint name="left_shoulder_roll_joint_X6">
        <command_interface name="position">
          <param name="min">-0.20944</param>
          <param name="max">2.93215</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">0.1</param>
        </state_interface>
        <state_interface name="velocity" />
        <state_interface name="effort" />
      </joint>

      <joint name="left_shoulder_yaw_joint_X4">
        <command_interface name="position">
          <param name="min">-1.74533</param>
          <param name="max">2.96706</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity" />
        <state_interface name="effort" />
      </joint>

      <joint name="left_elbow_pitch_joint_X6">
        <command_interface name="position">
          <param name="min">-1.309</param>
          <param name="max">1.8326</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">-0.1</param>
        </state_interface>
        <state_interface name="velocity" />
        <state_interface name="effort" />
      </joint>

      <joint name="left_wrist_yaw_joint_X4">
        <command_interface name="position">
          <param name="min">-2.35619</param>
          <param name="max">2.35619</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity" />
        <state_interface name="effort" />
      </joint>

      <joint name="left_wrist_roll_joint_X4">
        <command_interface name="position">
          <param name="min">-1.5708</param>
          <param name="max">1.5708</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity" />
        <state_interface name="effort" />
      </joint>

      <!-- === RIGHT ARM === -->
      <joint name="right_shoulder_pitch_joint_X6">
        <command_interface name="position">
          <param name="min">-3.01942</param>
          <param name="max">1.69297</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity" />
        <state_interface name="effort" />
      </joint>

      <joint name="right_shoulder_roll_joint_X6">
        <command_interface name="position">
          <param name="min">-2.93215</param>
          <param name="max">0.20944</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">-0.1</param>
        </state_interface>
        <state_interface name="velocity" />
        <state_interface name="effort" />
      </joint>

      <joint name="right_shoulder_yaw_joint_X4">
        <command_interface name="position">
          <param name="min">-2.96706</param>
          <param name="max">1.74533</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity" />
        <state_interface name="effort" />
      </joint>

      <joint name="right_elbow_pitch_joint_X6">
        <command_interface name="position">
          <param name="min">-1.309</param>
          <param name="max">1.8326</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">-0.1</param>
        </state_interface>
        <state_interface name="velocity" />
        <state_interface name="effort" />
      </joint>

      <joint name="right_wrist_yaw_joint_X4">
        <command_interface name="position">
          <param name="min">-2.35619</param>
          <param name="max">2.35619</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity" />
        <state_interface name="effort" />
      </joint>

      <joint name="right_wrist_roll_joint_X4">
        <command_interface name="position">
          <param name="min">-1.65806</param>
          <param name="max">1.65806</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity" />
        <state_interface name="effort" />
      </joint>



      <!-- === LEFT LEG === -->
      <joint name="left_hip_pitch_joint_X8">
        <command_interface name="position">
          <param name="min">-2.61799</param>
          <param name="max">2.61799</param>
        </command_interface>
        <state_interface name="position" />
        <state_interface name="velocity" />
        <state_interface name="effort" />
      </joint>

      <joint name="left_hip_roll_joint_X8">
        <command_interface name="position">
          <param name="min">-0.383972</param>
          <param name="max">3.22886</param>
        </command_interface>
        <state_interface name="position" />
        <state_interface name="velocity" />
        <state_interface name="effort" />
      </joint>

      <joint name="left_hip_yaw_joint_X8">
        <command_interface name="position">
          <param name="min">-2.15199</param>
          <param name="max">2.09003</param>
        </command_interface>
        <state_interface name="position" />
        <state_interface name="velocity" />
        <state_interface name="effort" />
      </joint>

      <joint name="left_knee_joint_X8">
        <command_interface name="position">
          <param name="min">0</param>
          <param name="max">1.51844</param>
        </command_interface>
        <state_interface name="position" />
        <state_interface name="velocity" />
        <state_interface name="effort" />
      </joint>

      <joint name="left_ankle_roll_joint_X4">
        <command_interface name="position">
          <param name="min">-0.785398</param>
          <param name="max">0.785398</param>
        </command_interface>
        <state_interface name="position" />
        <state_interface name="velocity" />
        <state_interface name="effort" />
      </joint>

      <joint name="left_ankle_pitch_joint_X4">
        <command_interface name="position">
          <param name="min">-0.785398</param>
          <param name="max">0.785398</param>
        </command_interface>
        <state_interface name="position" />
        <state_interface name="velocity" />
        <state_interface name="effort" />
      </joint>

      <!-- === RIGHT LEG === -->
      <joint name="right_hip_pitch_joint_X8">
        <command_interface name="position">
          <param name="min">-2.61799</param>
          <param name="max">2.61799</param>
        </command_interface>
        <state_interface name="position" />
        <state_interface name="velocity" />
        <state_interface name="effort" />
      </joint>

      <joint name="right_hip_roll_joint_X8">
        <command_interface name="position">
          <param name="min">-3.22886</param>
          <param name="max">0.383972</param>
        </command_interface>
        <state_interface name="position" />
        <state_interface name="velocity" />
        <state_interface name="effort" />
      </joint>

      <joint name="right_hip_yaw_joint_X8">
        <command_interface name="position">
          <param name="min">-1.5708</param>
          <param name="max">1.5708</param>
        </command_interface>
        <state_interface name="position" />
        <state_interface name="velocity" />
        <state_interface name="effort" />
      </joint>

      <joint name="right_knee_joint_X8">
        <command_interface name="position">
          <param name="min">0</param>
          <param name="max">1.51844</param>
        </command_interface>
        <state_interface name="position" />
        <state_interface name="velocity" />
        <state_interface name="effort" />
      </joint>

      <joint name="right_ankle_roll_joint_X4">
        <command_interface name="position">
          <param name="min">-0.785398</param>
          <param name="max">0.785398</param>
        </command_interface>
        <state_interface name="position" />
        <state_interface name="velocity" />
        <state_interface name="effort" />
      </joint>

      <joint name="right_ankle_pitch_joint_X4">
        <command_interface name="position">
          <param name="min">-0.785398</param>
          <param name="max">0.785398</param>
        </command_interface>
        <state_interface name="position" />
        <state_interface name="velocity" />
        <state_interface name="effort" />
      </joint>

    </ros2_control>
  </xacro:macro>

  <!-- The hands are a separate system, as in dual_arm_description. They are their own
       hardware on the real robot, and the mimic joints below have no command interface,
       which keeps that oddity out of the body block. -->
  <xacro:macro name="full_robot_ros2_control_hands">
    <ros2_control name="HandSystem" type="system">
      <hardware>
        <plugin>gz_ros2_control/GazeboSimSystem</plugin>
      </hardware>

      <!-- === ACTUATED (6 per hand) === -->
      <joint name="left_thumb_proximal_yaw_joint">
        <command_interface name="position">
          <param name="min">0</param>
          <param name="max">1.31</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">0.1</param>
        </state_interface>
        <state_interface name="velocity" />
        <state_interface name="effort" />
      </joint>
      <joint name="left_thumb_proximal_pitch_joint">
        <command_interface name="position">
          <param name="min">0</param>
          <param name="max">0.61</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">0.1</param>
        </state_interface>
        <state_interface name="velocity" />
        <state_interface name="effort" />
      </joint>
      <joint name="left_index_proximal_joint">
        <command_interface name="position">
          <param name="min">0</param>
          <param name="max">1.47</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">0.1</param>
        </state_interface>
        <state_interface name="velocity" />
        <state_interface name="effort" />
      </joint>
      <joint name="left_middle_proximal_joint">
        <command_interface name="position">
          <param name="min">0</param>
          <param name="max">1.47</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">0.1</param>
        </state_interface>
        <state_interface name="velocity" />
        <state_interface name="effort" />
      </joint>
      <joint name="left_ring_proximal_joint">
        <command_interface name="position">
          <param name="min">0</param>
          <param name="max">1.47</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">0.1</param>
        </state_interface>
        <state_interface name="velocity" />
        <state_interface name="effort" />
      </joint>
      <joint name="left_pinky_proximal_joint">
        <command_interface name="position">
          <param name="min">0</param>
          <param name="max">1.47</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">0.1</param>
        </state_interface>
        <state_interface name="velocity" />
        <state_interface name="effort" />
      </joint>

      <joint name="right_thumb_proximal_yaw_joint">
        <command_interface name="position">
          <param name="min">0.0</param>
          <param name="max">1.308</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">0.1</param>
        </state_interface>
        <state_interface name="velocity" />
        <state_interface name="effort" />
      </joint>
      <joint name="right_thumb_proximal_pitch_joint">
        <command_interface name="position">
          <param name="min">0</param>
          <param name="max">0.6</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">0.1</param>
        </state_interface>
        <state_interface name="velocity" />
        <state_interface name="effort" />
      </joint>
      <joint name="right_index_proximal_joint">
        <command_interface name="position">
          <param name="min">0</param>
          <param name="max">1.47</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">0.1</param>
        </state_interface>
        <state_interface name="velocity" />
        <state_interface name="effort" />
      </joint>
      <joint name="right_middle_proximal_joint">
        <command_interface name="position">
          <param name="min">0</param>
          <param name="max">1.47</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">0.1</param>
        </state_interface>
        <state_interface name="velocity" />
        <state_interface name="effort" />
      </joint>
      <joint name="right_ring_proximal_joint">
        <command_interface name="position">
          <param name="min">0</param>
          <param name="max">1.47</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">0.1</param>
        </state_interface>
        <state_interface name="velocity" />
        <state_interface name="effort" />
      </joint>
      <joint name="right_pinky_proximal_joint">
        <command_interface name="position">
          <param name="min">0</param>
          <param name="max">1.47</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">0.1</param>
        </state_interface>
        <state_interface name="velocity" />
        <state_interface name="effort" />
      </joint>

      <!-- === MIMIC (driven by the proximal joints; state only, no command) === -->
      <joint name="left_thumb_intermediate_joint">
        <state_interface name="position" />
        <state_interface name="velocity" />
        <state_interface name="effort" />
      </joint>
      <joint name="left_thumb_distal_joint">
        <state_interface name="position" />
        <state_interface name="velocity" />
        <state_interface name="effort" />
      </joint>
      <joint name="left_index_intermediate_joint">
        <state_interface name="position" />
        <state_interface name="velocity" />
        <state_interface name="effort" />
      </joint>
      <joint name="left_middle_intermediate_joint">
        <state_interface name="position" />
        <state_interface name="velocity" />
        <state_interface name="effort" />
      </joint>
      <joint name="left_ring_intermediate_joint">
        <state_interface name="position" />
        <state_interface name="velocity" />
        <state_interface name="effort" />
      </joint>
      <joint name="left_pinky_intermediate_joint">
        <state_interface name="position" />
        <state_interface name="velocity" />
        <state_interface name="effort" />
      </joint>
      <joint name="right_thumb_intermediate_joint">
        <state_interface name="position" />
        <state_interface name="velocity" />
        <state_interface name="effort" />
      </joint>
      <joint name="right_thumb_distal_joint">
        <state_interface name="position" />
        <state_interface name="velocity" />
        <state_interface name="effort" />
      </joint>
      <joint name="right_index_intermediate_joint">
        <state_interface name="position" />
        <state_interface name="velocity" />
        <state_interface name="effort" />
      </joint>
      <joint name="right_middle_intermediate_joint">
        <state_interface name="position" />
        <state_interface name="velocity" />
        <state_interface name="effort" />
      </joint>
      <joint name="right_ring_intermediate_joint">
        <state_interface name="position" />
        <state_interface name="velocity" />
        <state_interface name="effort" />
      </joint>
      <joint name="right_pinky_intermediate_joint">
        <state_interface name="position" />
        <state_interface name="velocity" />
        <state_interface name="effort" />
      </joint>

    </ros2_control>
  </xacro:macro>

</robot>
