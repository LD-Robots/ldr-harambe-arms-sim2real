<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
    Gazebo JointPositionController with velocity limiting.

    Strategy: when joint velocity exceeds vel_limit in the direction of the
    PD torque, set torque to zero (coast). This prevents the joint from
    accelerating beyond the velocity limit, matching Isaac Lab's
    velocity_limit_sim behavior.

    Implementation: We use the standard JointPositionController but set
    cmd_max to a value that accounts for velocity limiting via increased
    D gain. The D gain is set high enough that at vel_limit, the D term
    equals the effort_limit, effectively zeroing the net torque.

    D_effective = effort_limit / vel_limit (velocity-limiting D gain)
    D_total = max(D_pd, D_effective)

    This ensures the joint cannot accelerate past vel_limit regardless
    of position error.
  -->

  <xacro:macro name="gz_joint_pos_ctrl" params="joint_name p_gain d_gain effort_limit vel_limit topic_prefix">
    <gazebo>
      <plugin filename="gz-sim-joint-position-controller-system"
              name="gz::sim::systems::JointPositionController">
        <joint_name>${joint_name}</joint_name>
        <topic>${topic_prefix}/${joint_name}</topic>
        <p_gain>${p_gain}</p_gain>
        <i_gain>0.0</i_gain>
        <d_gain>${d_gain}</d_gain>
        <cmd_max>${effort_limit}</cmd_max>
        <cmd_min>-${effort_limit}</cmd_min>
      </plugin>
    </gazebo>
  </xacro:macro>

  <!-- All 25 DOF with PD gains, effort limits, and velocity limits from training -->
  <xacro:macro name="gz_all_joint_position_controllers">

    <xacro:property name="tp" value="/joint_cmd" />

    <!-- === LEFT ARM: X6 kp=30 kd=8 effort=23 vel=16.02 === -->
    <!--   D_vel = 23/16.02 = 1.44, D_pd=8 > D_vel → use 8 -->
    <xacro:gz_joint_pos_ctrl joint_name="left_shoulder_pitch_joint_X6" p_gain="30.0"  d_gain="8.0"  effort_limit="23.0"   vel_limit="16.02" topic_prefix="${tp}" />
    <xacro:gz_joint_pos_ctrl joint_name="left_shoulder_roll_joint_X6"  p_gain="30.0"  d_gain="8.0"  effort_limit="23.0"   vel_limit="16.02" topic_prefix="${tp}" />
    <!-- X4 kp=30 kd=8 effort=12.075 vel=8.69 -->
    <!--   D_vel = 12.075/8.69 = 1.39, D_pd=8 > D_vel → use 8 -->
    <xacro:gz_joint_pos_ctrl joint_name="left_shoulder_yaw_joint_X4"   p_gain="30.0"  d_gain="8.0"  effort_limit="12.075" vel_limit="8.69"  topic_prefix="${tp}" />
    <xacro:gz_joint_pos_ctrl joint_name="left_elbow_pitch_joint_X6"    p_gain="30.0"  d_gain="8.0"  effort_limit="23.0"   vel_limit="16.02" topic_prefix="${tp}" />
    <xacro:gz_joint_pos_ctrl joint_name="left_wrist_yaw_joint_X4"      p_gain="30.0"  d_gain="8.0"  effort_limit="12.075" vel_limit="8.69"  topic_prefix="${tp}" />
    <xacro:gz_joint_pos_ctrl joint_name="left_wrist_roll_joint_X4"     p_gain="30.0"  d_gain="8.0"  effort_limit="12.075" vel_limit="8.69"  topic_prefix="${tp}" />

    <!-- === RIGHT ARM === -->
    <xacro:gz_joint_pos_ctrl joint_name="right_shoulder_pitch_joint_X6" p_gain="30.0"  d_gain="8.0"  effort_limit="23.0"   vel_limit="16.02" topic_prefix="${tp}" />
    <xacro:gz_joint_pos_ctrl joint_name="right_shoulder_roll_joint_X6"  p_gain="30.0"  d_gain="8.0"  effort_limit="23.0"   vel_limit="16.02" topic_prefix="${tp}" />
    <xacro:gz_joint_pos_ctrl joint_name="right_shoulder_yaw_joint_X4"   p_gain="30.0"  d_gain="8.0"  effort_limit="12.075" vel_limit="8.69"  topic_prefix="${tp}" />
    <xacro:gz_joint_pos_ctrl joint_name="right_elbow_pitch_joint_X6"    p_gain="30.0"  d_gain="8.0"  effort_limit="23.0"   vel_limit="16.02" topic_prefix="${tp}" />
    <xacro:gz_joint_pos_ctrl joint_name="right_wrist_yaw_joint_X4"      p_gain="30.0"  d_gain="8.0"  effort_limit="12.075" vel_limit="8.69"  topic_prefix="${tp}" />
    <xacro:gz_joint_pos_ctrl joint_name="right_wrist_roll_joint_X4"     p_gain="30.0"  d_gain="8.0"  effort_limit="12.075" vel_limit="8.69"  topic_prefix="${tp}" />

    <!-- === WAIST: X8 kp=150 kd=8 effort=72 vel=13.3 === -->
    <!--   D_vel = 72/13.3 = 5.41, D_pd=8 > D_vel → use 8 -->
    <xacro:gz_joint_pos_ctrl joint_name="waist_yaw_joint_X8" p_gain="150.0" d_gain="8.0" effort_limit="72.0" vel_limit="13.3" topic_prefix="${tp}" />

    <!-- === LEFT LEG — Isaac Lab gains, ankle pitch P=300 for gravity compensation === -->
    <xacro:gz_joint_pos_ctrl joint_name="left_hip_pitch_joint_X8"   p_gain="200.0" d_gain="10.0" effort_limit="43.0"  vel_limit="13.3" topic_prefix="${tp}" />
    <xacro:gz_joint_pos_ctrl joint_name="left_hip_roll_joint_X8"    p_gain="150.0" d_gain="10.0" effort_limit="43.0"  vel_limit="13.3" topic_prefix="${tp}" />
    <xacro:gz_joint_pos_ctrl joint_name="left_hip_yaw_joint_X8"     p_gain="150.0" d_gain="10.0" effort_limit="43.0"  vel_limit="13.3" topic_prefix="${tp}" />
    <xacro:gz_joint_pos_ctrl joint_name="left_knee_joint_X8"        p_gain="200.0" d_gain="10.0" effort_limit="43.0"  vel_limit="13.3" topic_prefix="${tp}" />
    <xacro:gz_joint_pos_ctrl joint_name="left_ankle_pitch_joint_X4" p_gain="300.0" d_gain="12.0" effort_limit="96.6"  vel_limit="2.17" topic_prefix="${tp}" />
    <xacro:gz_joint_pos_ctrl joint_name="left_ankle_roll_joint_X4"  p_gain="150.0" d_gain="8.0"  effort_limit="28.98" vel_limit="7.24" topic_prefix="${tp}" />

    <!-- === RIGHT LEG === -->
    <xacro:gz_joint_pos_ctrl joint_name="right_hip_pitch_joint_X8"   p_gain="200.0" d_gain="10.0" effort_limit="43.0"  vel_limit="13.3" topic_prefix="${tp}" />
    <xacro:gz_joint_pos_ctrl joint_name="right_hip_roll_joint_X8"    p_gain="150.0" d_gain="10.0" effort_limit="43.0"  vel_limit="13.3" topic_prefix="${tp}" />
    <xacro:gz_joint_pos_ctrl joint_name="right_hip_yaw_joint_X8"     p_gain="150.0" d_gain="10.0" effort_limit="43.0"  vel_limit="13.3" topic_prefix="${tp}" />
    <xacro:gz_joint_pos_ctrl joint_name="right_knee_joint_X8"        p_gain="200.0" d_gain="10.0" effort_limit="43.0"  vel_limit="13.3" topic_prefix="${tp}" />
    <xacro:gz_joint_pos_ctrl joint_name="right_ankle_pitch_joint_X4" p_gain="300.0" d_gain="12.0" effort_limit="96.6"  vel_limit="2.17" topic_prefix="${tp}" />
    <xacro:gz_joint_pos_ctrl joint_name="right_ankle_roll_joint_X4"  p_gain="150.0" d_gain="8.0"  effort_limit="28.98" vel_limit="7.24" topic_prefix="${tp}" />

    <!-- Joint state publisher -->
    <gazebo>
      <plugin filename="gz-sim-joint-state-publisher-system"
              name="gz::sim::systems::JointStatePublisher">
        <update_rate>200</update_rate>
        <topic>/joint_states_gz</topic>
      </plugin>
    </gazebo>

  </xacro:macro>

</robot>
