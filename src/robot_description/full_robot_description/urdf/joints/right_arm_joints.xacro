<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ================================================================== -->
  <!-- Right Arm                                                         -->
  <!-- ================================================================== -->
  <joint name="right_shoulder_pitch_joint_X6" type="revolute">
    <origin xyz="0 -0.1695 0.423977" rpy="0 0 0"/>
    <parent link="urdf_simplified_torso"/>
    <child link="urdf_r_shoulder_assembly"/>
    <axis xyz="0 1 0"/>
    <limit effort="${X6_moderate_effort}" velocity="${X6_rated_velocity}" lower="-3.02" upper="1.69"/>
    <dynamics friction="${X6_friction}" damping="${X6_damping}"/>
  </joint>

  <joint name="right_shoulder_roll_joint_X6" type="revolute">
    <origin xyz="0.0456571 -0.07 0.00560611" rpy="0 -0.122176 0"/>
    <parent link="urdf_r_shoulder_assembly"/>
    <child link="urdf_r_upper_arm_assembly"/>
    <axis xyz="1 0 0"/>
    <limit effort="${X6_moderate_effort}" velocity="${X6_rated_velocity}" lower="-2.93" upper="0.21"/>
    <dynamics friction="${X6_friction}" damping="${X6_damping}"/>
  </joint>

  <joint name="right_shoulder_yaw_joint_X4" type="revolute">
    <origin xyz="-0.046 -0.0353444 -0.166285" rpy="-0.20937 0.00530239 0.0249667"/>
    <parent link="urdf_r_upper_arm_assembly"/>
    <child link="urdf_r_elbow_assembly"/>
    <axis xyz="0 0 1"/>
    <limit effort="${X4_moderate_effort}" velocity="${X4_rated_velocity}" lower="-2.97" upper="1.75"/>
    <dynamics friction="${X4_friction}" damping="${X4_damping}"/>
  </joint>

  <joint name="right_elbow_pitch_joint_X6" type="revolute">
    <origin xyz="0.0220994 -0.033341 -0.065" rpy="0 -0.0190815 0.58534"/>
    <parent link="urdf_r_elbow_assembly"/>
    <child link="urdf_r_upper_forearm_assembly"/>
    <axis xyz="0 1 0"/>
    <limit effort="${X6_moderate_effort}" velocity="${X6_rated_velocity}" lower="-1.31" upper="1.83"/>
    <dynamics friction="${X6_friction}" damping="${X6_damping}"/>
  </joint>

  <joint name="right_wrist_yaw_joint_X4" type="revolute">
    <origin xyz="0.0403774 0.04 -0.163076" rpy="0.142861 -0.196891 -0.634034"/>
    <parent link="urdf_r_upper_forearm_assembly"/>
    <child link="urdf_r_lower_forearm_assembly"/>
    <axis xyz="0 0 1"/>
    <limit effort="${X4_moderate_effort}" velocity="${X4_rated_velocity}" lower="-2.36" upper="2.36"/>
    <dynamics friction="${X4_friction}" damping="${X4_damping}"/>
  </joint>

  <joint name="right_wrist_roll_joint_X4" type="revolute">
    <origin xyz="0.0219763 0.0156857 -0.0565" rpy="0.248276 0 0.619896"/>
    <parent link="urdf_r_lower_forearm_assembly"/>
    <child link="urdf_r_wrist_assembly"/>
    <axis xyz="1 0 0"/>
    <limit effort="${X4_moderate_effort}" velocity="${X4_rated_velocity}" lower="-1.57" upper="1.57"/>
    <dynamics friction="${X4_friction}" damping="${X4_damping}"/>
  </joint>

</robot>
