<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ================================================================== -->
  <!-- Leg joint type — set fixed_legs:=true to lock leg joints          -->
  <!-- ================================================================== -->
  <xacro:arg name="fixed_legs" default="false"/>
  <xacro:property name="leg_joint_type" value="${'fixed' if '$(arg fixed_legs)' == 'true' else 'revolute'}"/>
  
  <!-- ================================================================== -->
  <!-- Waist joint type — independent from the arm and leg configuration -->
  <!-- ================================================================== -->
  <xacro:arg name="fixed_waist" default="true"/>
  <xacro:property name="waist_joint_type" value="${'fixed' if '$(arg fixed_waist)' == 'true' else 'revolute'}"/>

  <!-- ================================================================== -->
  <!-- Body                                                              -->
  <!-- ================================================================== -->
  <joint name="waist_yaw_joint_X8" type="${waist_joint_type}">
    <origin xyz="-0.00371302 0.000225649 0.0824545" rpy="0 0 0"/>
    <parent link="urdf_base"/>
    <child link="urdf_simplified_torso"/>
    <axis xyz="0 0 1"/>
    <limit effort="${X8_moderate_effort}" velocity="${X8_rated_velocity}" lower="-2.60054" upper="2.60054"/>
    <dynamics damping="${X8_damping}" friction="${X8_friction}"/>
  </joint>

</robot>
