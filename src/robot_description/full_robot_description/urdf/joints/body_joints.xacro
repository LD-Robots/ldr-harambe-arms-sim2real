<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ================================================================== -->
  <!-- Leg joint type — set fixed_legs:=true to lock leg joints          -->
  <!-- ================================================================== -->
  <xacro:arg name="fixed_legs" default="false"/>
  <xacro:property name="leg_joint_type"  value="revolute"/>
  <xacro:if value="$(arg fixed_legs)">
    <xacro:property name="leg_joint_type" value="fixed"/>
  </xacro:if>

  <!-- ================================================================== -->
  <!-- Waist yaw — locked when only_left or only_arms is true            -->
  <!-- ================================================================== -->
  <xacro:arg name="only_left" default="true"/>
  <xacro:arg name="only_arms" default="false"/>
  <xacro:property name="waist_joint_type" value="revolute"/>
  <xacro:if value="$(arg only_left)">
    <xacro:property name="waist_joint_type" value="fixed"/>
  </xacro:if>
  <xacro:if value="$(arg only_arms)">
    <xacro:property name="waist_joint_type" value="fixed"/>
  </xacro:if>

  <!-- ================================================================== -->
  <!-- Body                                                              -->
  <!-- ================================================================== -->
  <joint name="waist_yaw_joint_X8" type="${waist_joint_type}">
    <origin xyz="0.070373 -0.000705351 -0.281099" rpy="0 0 0"/>
    <parent link="urdf_base"/>
    <child link="urdf_simplified_torso"/>
    <axis xyz="0 0 1"/>
    <limit effort="${X8_moderate_effort}" velocity="${X8_rated_velocity}" lower="-2.60054" upper="2.60054"/>
    <dynamics damping="${X8_damping}" friction="${X8_friction}"/>
  </joint>

</robot>
