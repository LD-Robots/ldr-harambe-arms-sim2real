<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ================================================================== -->
  <!-- Left Arm                                                          -->
  <!-- ================================================================== -->
  <joint name="left_shoulder_pitch_joint_X6" type="revolute">
    <origin xyz="0 0.1695 0.423977" rpy="0 0 0"/>
    <parent link="urdf_simplified_torso"/>
    <child link="urdf_l_shoulder_assembly"/>
    <axis xyz="0 1 0"/>
    <limit effort="${X6_moderate_effort}" velocity="${X6_rated_velocity}" lower="-3.02" upper="1.69"/>
    <dynamics friction="${X6_friction}" damping="${X6_damping}"/>
  </joint>

  <joint name="left_shoulder_roll_joint_X6" type="revolute">
    <origin xyz="0.0456571 0.07 0.00560611" rpy="0 -0.122176 0"/>
    <parent link="urdf_l_shoulder_assembly"/>
    <child link="urdf_l_upper_arm_assembly"/>
    <axis xyz="1 0 0"/>
    <limit effort="${X6_moderate_effort}" velocity="${X6_rated_velocity}" lower="-0.21" upper="2.93"/>
    <dynamics friction="${X6_friction}" damping="${X6_damping}"/>
  </joint>

  <joint name="left_shoulder_yaw_joint_X4" type="revolute">
    <origin xyz="-0.046 0.034306 -0.161394" rpy="0.209383 0.00530439 -0.024967"/>
    <parent link="urdf_l_upper_arm_assembly"/>
    <child link="urdf_l_elbow_assembly"/>
    <axis xyz="0 0 1"/>
    <limit effort="${X4_moderate_effort}" velocity="${X4_rated_velocity}" lower="-1.75" upper="2.97"/>
    <dynamics friction="${X4_friction}" damping="${X4_damping}"/>
  </joint>

  <joint name="left_elbow_pitch_joint_X6" type="revolute">
    <origin xyz="0.0193369 0.0291733 -0.075" rpy="0 -0.0190922 -0.585347"/>
    <parent link="urdf_l_elbow_assembly"/>
    <child link="urdf_l_upper_forearm_assembly"/>
    <axis xyz="0 1 0"/>
    <limit effort="${X6_moderate_effort}" velocity="${X6_rated_velocity}" lower="-1.31" upper="1.83"/>
    <dynamics friction="${X6_friction}" damping="${X6_damping}"/>
  </joint>

  <joint name="left_wrist_yaw_joint_X4" type="revolute">
    <origin xyz="0.0391735 -0.035 -0.158223" rpy="-0.14286 -0.196878 0.634041"/>
    <parent link="urdf_l_upper_forearm_assembly"/>
    <child link="urdf_l_lower_forearm_assembly"/>
    <axis xyz="0 0 1"/>
    <limit effort="${X4_moderate_effort}" velocity="${X4_rated_velocity}" lower="-2.36" upper="2.36"/>
    <dynamics friction="${X4_friction}" damping="${X4_damping}"/>
  </joint>

  <joint name="left_wrist_roll_joint_X4" type="revolute">
    <origin xyz="0.0219762 -0.0156859 -0.0615" rpy="-0.248279 0 -0.619909"/>
    <parent link="urdf_l_lower_forearm_assembly"/>
    <child link="urdf_l_wrist_assembly"/>
    <axis xyz="1 0 0"/>
    <limit effort="${X4_moderate_effort}" velocity="${X4_rated_velocity}" lower="-1.57" upper="1.57"/>
    <dynamics friction="${X4_friction}" damping="${X4_damping}"/>
  </joint>

</robot>
