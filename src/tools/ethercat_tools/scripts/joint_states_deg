#!/usr/bin/env python3
"""Republish /joint_states in DEGREES on /joint_states_deg.

A general-purpose version of harambe_ankle_ethercat_driver's ankle_degrees.py:
converts ALL joints (not just the ankles) from radians to degrees so they are
easy to read in `ros2 topic echo`, log to CSV, or plot per-name in PlotJuggler.
Positions and velocities are converted rad->deg; effort is passed through.

Passive listener (no command path; safe to run any time, including the
read-only viewer). Useful for capturing the ankle calibration recordings the
v2 driver's table-vs-recording test consumes.

Parameters:
  input_topic  (str,  default 'joint_states')      source topic (radians)
  output_topic (str,  default 'joint_states_deg')   republished topic (degrees)
  joints       (str[], default [] = all)            optional name allow-list

Examples:
  ros2 run ethercat_tools joint_states_deg
  ros2 run ethercat_tools joint_states_deg --ros-args \
    -p joints:='[left_ankle_pitch_joint_X4,left_ankle_roll_joint_X4]'
"""
import math

import rclpy
from rclpy.node import Node
from sensor_msgs.msg import JointState


class JointStatesDeg(Node):
    def __init__(self):
        super().__init__("joint_states_deg")
        self.declare_parameter("input_topic", "joint_states")
        self.declare_parameter("output_topic", "joint_states_deg")
        self.declare_parameter("joints", [""])

        in_topic = self.get_parameter("input_topic").value
        out_topic = self.get_parameter("output_topic").value
        wanted = [j for j in self.get_parameter("joints").value if j]
        self._filter = set(wanted)

        self.pub = self.create_publisher(JointState, out_topic, 10)
        self.create_subscription(JointState, in_topic, self._on_joint_states, 10)
        scope = f"{len(self._filter)} joints" if self._filter else "all joints"
        self.get_logger().info(
            f"Republishing {scope} from /{in_topic} (rad) to /{out_topic} (deg)")

    def _on_joint_states(self, msg: JointState):
        out = JointState()
        out.header = msg.header
        for i, name in enumerate(msg.name):
            if self._filter and name not in self._filter:
                continue
            out.name.append(name)
            if i < len(msg.position):
                out.position.append(math.degrees(msg.position[i]))
            if i < len(msg.velocity):
                out.velocity.append(math.degrees(msg.velocity[i]))
            if i < len(msg.effort):
                out.effort.append(msg.effort[i])
        if out.name:
            self.pub.publish(out)


def main():
    rclpy.init()
    node = JointStatesDeg()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        node.destroy_node()
        if rclpy.ok():
            rclpy.shutdown()


if __name__ == "__main__":
    main()
