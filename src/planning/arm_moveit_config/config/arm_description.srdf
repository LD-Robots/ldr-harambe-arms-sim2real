<?xml version="1.0" encoding="UTF-8"?>
<!--This does not replace URDF, and is not an extension of URDF.
    This is a format for representing semantic information about the robot structure.
    A URDF file must exist for this robot as well, where the joints and the links that are referenced are defined
-->
<robot name="arm_description">
    <!--GROUPS: Representation of a set of joints and links. This can be useful for specifying DOF to plan for, defining arms, end effectors, etc-->
    <group name="arm">
        <chain base_link="urdf_base" tip_link="urdf_l_wrist_assembly"/>
    </group>
    <group name="hand">
        <joint name="left_thumb_proximal_yaw_joint"/>
        <joint name="left_thumb_proximal_pitch_joint"/>
        <joint name="left_index_proximal_joint"/>
        <joint name="left_middle_proximal_joint"/>
        <joint name="left_ring_proximal_joint"/>
        <joint name="left_pinky_proximal_joint"/>
    </group>
    <!--
        GENERIC GROUP STATES

        Reusable states kept for compatibility with reset_robot.py, MoveIt demos,
        and the existing MTC examples. These states are not tied to one scene.
    -->
    <group_state name="home" group="arm">
        <joint name="left_shoulder_pitch_joint_X6" value="0.0"/>
        <joint name="left_shoulder_roll_joint_X6" value="0.1"/>
        <joint name="left_shoulder_yaw_joint_X4" value="0.0"/>
        <joint name="left_elbow_pitch_joint_X6" value="-0.1"/>
        <joint name="left_wrist_yaw_joint_X4" value="0.0"/>
        <joint name="left_wrist_roll_joint_X4" value="0.0"/>
    </group_state>
    <group_state name="ready" group="arm">
        <joint name="left_shoulder_pitch_joint_X6" value="-0.5"/>
        <joint name="left_shoulder_roll_joint_X6" value="0.5"/>
        <joint name="left_shoulder_yaw_joint_X4" value="0.0"/>
        <joint name="left_elbow_pitch_joint_X6" value="-0.5"/>
        <joint name="left_wrist_yaw_joint_X4" value="0.0"/>
        <joint name="left_wrist_roll_joint_X4" value="0.0"/>
    </group_state>
    <group_state name="open" group="hand">
        <joint name="left_thumb_proximal_yaw_joint" value="0.0"/>
        <joint name="left_thumb_proximal_pitch_joint" value="0.0"/>
        <joint name="left_index_proximal_joint" value="0.0"/>
        <joint name="left_middle_proximal_joint" value="0.0"/>
        <joint name="left_ring_proximal_joint" value="0.0"/>
        <joint name="left_pinky_proximal_joint" value="0.0"/>
    </group_state>
    <group_state name="close" group="hand">
        <joint name="left_thumb_proximal_yaw_joint" value="1.0"/>
        <joint name="left_thumb_proximal_pitch_joint" value="0.6"/>
        <joint name="left_index_proximal_joint" value="1.2"/>
        <joint name="left_middle_proximal_joint" value="1.2"/>
        <joint name="left_ring_proximal_joint" value="1.2"/>
        <joint name="left_pinky_proximal_joint" value="1.2"/>
    </group_state>

    <!--
        LAB-MTC CYLINDER PICK-AND-PLACE

        Hard-coded sequence for the cylinder from lab-mtc.sdf. The numeric
        prefixes document the intended execution order and keep the states
        ordered in tools that sort named states alphabetically.

        01 arm  : move above the table before travelling toward the cylinder
        02 arm  : approach the cylinder with the hand still open
        03 hand : rotate the thumb around the cylinder before closing
        04 hand : close all fingers and grasp the cylinder
        05 arm  : lift the grasped cylinder clear of the table
        06 arm  : move the cylinder to its placement pose on the table
        07 hand : open the fingers and release the cylinder
        08 arm  : retreat to a collision-safe pose away from the cylinder/table
        09 arm  : return to the initial home pose
    -->

    <!-- 01: Raise the arm horizontally to clear the table. -->
    <group_state name="01_arm_table_clearance" group="arm">
        <joint name="left_shoulder_pitch_joint_X6" value="0.0"/>
        <joint name="left_shoulder_roll_joint_X6" value="1.57"/>
        <joint name="left_shoulder_yaw_joint_X4" value="0.0"/>
        <joint name="left_elbow_pitch_joint_X6" value="0.0"/>
        <joint name="left_wrist_yaw_joint_X4" value="0.0"/>
        <joint name="left_wrist_roll_joint_X4" value="0.0"/>
    </group_state>

    <!-- 02: Bring the open hand close to the cylinder without touching it. -->
    <group_state name="02_arm_cylinder_pregrasp" group="arm">
        <joint name="left_shoulder_pitch_joint_X6" value="-0.2094395"/>
        <joint name="left_shoulder_roll_joint_X6" value="0.174533"/>
        <joint name="left_shoulder_yaw_joint_X4" value="0.314159"/>
        <joint name="left_elbow_pitch_joint_X6" value="-1.186824"/>
        <joint name="left_wrist_yaw_joint_X4" value="0.052360"/>
        <joint name="left_wrist_roll_joint_X4" value="-0.157080"/>
    </group_state>

    <!-- 03: Rotate only the thumb so the cylinder will be enclosed from all sides. -->
    <group_state name="03_hand_cylinder_pregrasp" group="hand">
        <joint name="left_thumb_proximal_yaw_joint" value="1.3"/>
        <joint name="left_thumb_proximal_pitch_joint" value="0.0"/>
        <joint name="left_index_proximal_joint" value="0.0"/>
        <joint name="left_middle_proximal_joint" value="0.0"/>
        <joint name="left_ring_proximal_joint" value="0.0"/>
        <joint name="left_pinky_proximal_joint" value="0.0"/>
    </group_state>

    <!-- 04: Close the hand around the cylinder. -->
    <group_state name="04_hand_cylinder_grasp" group="hand">
        <joint name="left_thumb_proximal_yaw_joint" value="1.3"/>
        <joint name="left_thumb_proximal_pitch_joint" value="0.296706"/>
        <joint name="left_index_proximal_joint" value="0.698132"/>
        <joint name="left_middle_proximal_joint" value="0.645772"/>
        <joint name="left_ring_proximal_joint" value="0.645772"/>
        <joint name="left_pinky_proximal_joint" value="0.645772"/>
    </group_state>

    <!-- 05: Lift the grasped cylinder above the table. -->
    <group_state name="05_arm_cylinder_lift" group="arm">
        <joint name="left_shoulder_pitch_joint_X6" value="-1.57"/>
        <joint name="left_shoulder_roll_joint_X6" value="0.174"/>
        <joint name="left_shoulder_yaw_joint_X4" value="0.0"/>
        <joint name="left_elbow_pitch_joint_X6" value="0.0"/>
        <joint name="left_wrist_yaw_joint_X4" value="0.0"/>
        <joint name="left_wrist_roll_joint_X4" value="0.0"/>
    </group_state>

    <!-- 06: Move the cylinder to the desired placement pose on the table. -->
    <group_state name="06_arm_cylinder_place" group="arm">
        <joint name="left_shoulder_pitch_joint_X6" value="0.157080"/>
        <joint name="left_shoulder_roll_joint_X6" value="0.087266"/>
        <joint name="left_shoulder_yaw_joint_X4" value="0.471239"/>
        <joint name="left_elbow_pitch_joint_X6" value="-1.570796"/>
        <joint name="left_wrist_yaw_joint_X4" value="0.209440"/>
        <joint name="left_wrist_roll_joint_X4" value="-0.104720"/>
    </group_state>

    <!-- 07: Open the hand thumb proximal pitchjoint and release the cylinder. -->
    <group_state name="07_hand_cylinder_release" group="hand">
        <joint name="left_thumb_proximal_yaw_joint" value="1.3"/>
        <joint name="left_thumb_proximal_pitch_joint" value="0.0"/>
        <joint name="left_index_proximal_joint" value="0.698132"/>
        <joint name="left_middle_proximal_joint" value="0.645772"/>
        <joint name="left_ring_proximal_joint" value="0.645772"/>
        <joint name="left_pinky_proximal_joint" value="0.645772"/>
    </group_state>

    <!-- 08: Open the hand and fully release the cylinder. Same joint values as generic "open". -->
    <group_state name="08_hand_cylinder_release" group="hand">
        <joint name="left_thumb_proximal_yaw_joint" value="0.0"/>
        <joint name="left_thumb_proximal_pitch_joint" value="0.0"/>
        <joint name="left_index_proximal_joint" value="0.0"/>
        <joint name="left_middle_proximal_joint" value="0.0"/>
        <joint name="left_ring_proximal_joint" value="0.0"/>
        <joint name="left_pinky_proximal_joint" value="0.0"/>
    </group_state>

    <!-- 08: Retreat from the released cylinder while maintaining table clearance. -->
    <group_state name="09_arm_post_release_retreat" group="arm">
        <joint name="left_shoulder_pitch_joint_X6" value="0.157080"/>
        <joint name="left_shoulder_roll_joint_X6" value="0.087266"/>
        <joint name="left_shoulder_yaw_joint_X4" value="1.571239"/>
        <joint name="left_elbow_pitch_joint_X6" value="-1.570796"/>
        <joint name="left_wrist_yaw_joint_X4" value="0.209440"/>
        <joint name="left_wrist_roll_joint_X4" value="-0.104720"/>
    </group_state>

    <!-- 09: Return to the initial arm pose. Same joint values as generic "home". -->
    <group_state name="10_arm_return_home" group="arm">
        <joint name="left_shoulder_pitch_joint_X6" value="0.0"/>
        <joint name="left_shoulder_roll_joint_X6" value="0.1"/>
        <joint name="left_shoulder_yaw_joint_X4" value="0.0"/>
        <joint name="left_elbow_pitch_joint_X6" value="-0.1"/>
        <joint name="left_wrist_yaw_joint_X4" value="0.0"/>
        <joint name="left_wrist_roll_joint_X4" value="0.0"/>
    </group_state>
    <!--END EFFECTOR-->
    <end_effector name="hand" parent_link="urdf_l_wrist_assembly" group="hand"/>
    <!--VIRTUAL JOINT-->
    <virtual_joint name="virtual_joint" type="fixed" parent_frame="world" child_link="urdf_base"/>

    <!--DISABLE COLLISIONS-->

    <!-- ===== Body: base <-> torso ===== -->
    <disable_collisions link1="urdf_base" link2="urdf_simplified_torso" reason="Adjacent"/>

    <!-- ===== Left arm chain (adjacent) ===== -->
    <!-- torso -> l_shoulder -> l_upper_arm -> l_elbow -> l_upper_forearm -> l_lower_forearm -> l_wrist -->
    <disable_collisions link1="urdf_simplified_torso" link2="urdf_l_shoulder_assembly" reason="Adjacent"/>
    <disable_collisions link1="urdf_l_shoulder_assembly" link2="urdf_l_upper_arm_assembly" reason="Adjacent"/>
    <disable_collisions link1="urdf_l_upper_arm_assembly" link2="urdf_l_elbow_assembly" reason="Adjacent"/>
    <disable_collisions link1="urdf_l_elbow_assembly" link2="urdf_l_upper_forearm_assembly" reason="Adjacent"/>
    <disable_collisions link1="urdf_l_upper_forearm_assembly" link2="urdf_l_lower_forearm_assembly" reason="Adjacent"/>
    <disable_collisions link1="urdf_l_lower_forearm_assembly" link2="urdf_l_wrist_assembly" reason="Adjacent"/>
    <!-- Left arm non-adjacent -->
    <disable_collisions link1="urdf_base" link2="urdf_l_shoulder_assembly" reason="Never"/>
    <disable_collisions link1="urdf_base" link2="urdf_l_upper_arm_assembly" reason="Never"/>
    <disable_collisions link1="urdf_simplified_torso" link2="urdf_l_upper_arm_assembly" reason="Never"/>
    <disable_collisions link1="urdf_simplified_torso" link2="urdf_l_elbow_assembly" reason="Never"/>
    <disable_collisions link1="urdf_l_shoulder_assembly" link2="urdf_l_elbow_assembly" reason="Never"/>
    <disable_collisions link1="urdf_l_shoulder_assembly" link2="urdf_l_upper_forearm_assembly" reason="Never"/>
    <disable_collisions link1="urdf_l_upper_arm_assembly" link2="urdf_l_upper_forearm_assembly" reason="Never"/>
    <disable_collisions link1="urdf_l_upper_arm_assembly" link2="urdf_l_lower_forearm_assembly" reason="Never"/>
    <disable_collisions link1="urdf_l_upper_arm_assembly" link2="urdf_l_wrist_assembly" reason="Never"/>
    <disable_collisions link1="urdf_l_elbow_assembly" link2="urdf_l_lower_forearm_assembly" reason="Never"/>
    <disable_collisions link1="urdf_l_elbow_assembly" link2="urdf_l_wrist_assembly" reason="Never"/>
    <disable_collisions link1="urdf_l_upper_forearm_assembly" link2="urdf_l_wrist_assembly" reason="Never"/>

    <!-- ===== Right arm chain (adjacent) ===== -->
    <!-- torso -> r_shoulder -> r_upper_arm -> r_elbow -> r_upper_forearm -> r_lower_forearm -> r_wrist -->
    <disable_collisions link1="urdf_simplified_torso" link2="urdf_r_shoulder_assembly" reason="Adjacent"/>
    <disable_collisions link1="urdf_r_shoulder_assembly" link2="urdf_r_upper_arm_assembly" reason="Adjacent"/>
    <disable_collisions link1="urdf_r_upper_arm_assembly" link2="urdf_r_elbow_assembly" reason="Adjacent"/>
    <disable_collisions link1="urdf_r_elbow_assembly" link2="urdf_r_upper_forearm_assembly" reason="Adjacent"/>
    <disable_collisions link1="urdf_r_upper_forearm_assembly" link2="urdf_r_lower_forearm_assembly" reason="Adjacent"/>
    <disable_collisions link1="urdf_r_lower_forearm_assembly" link2="urdf_r_wrist_assembly" reason="Adjacent"/>
    <!-- Right arm non-adjacent -->
    <disable_collisions link1="urdf_base" link2="urdf_r_shoulder_assembly" reason="Never"/>
    <disable_collisions link1="urdf_base" link2="urdf_r_upper_arm_assembly" reason="Never"/>
    <disable_collisions link1="urdf_simplified_torso" link2="urdf_r_upper_arm_assembly" reason="Never"/>
    <disable_collisions link1="urdf_simplified_torso" link2="urdf_r_elbow_assembly" reason="Never"/>
    <disable_collisions link1="urdf_r_shoulder_assembly" link2="urdf_r_elbow_assembly" reason="Never"/>
    <disable_collisions link1="urdf_r_shoulder_assembly" link2="urdf_r_upper_forearm_assembly" reason="Never"/>
    <disable_collisions link1="urdf_r_upper_arm_assembly" link2="urdf_r_upper_forearm_assembly" reason="Never"/>
    <disable_collisions link1="urdf_r_upper_arm_assembly" link2="urdf_r_lower_forearm_assembly" reason="Never"/>
    <disable_collisions link1="urdf_r_upper_arm_assembly" link2="urdf_r_wrist_assembly" reason="Never"/>
    <disable_collisions link1="urdf_r_elbow_assembly" link2="urdf_r_lower_forearm_assembly" reason="Never"/>
    <disable_collisions link1="urdf_r_elbow_assembly" link2="urdf_r_wrist_assembly" reason="Never"/>
    <disable_collisions link1="urdf_r_upper_forearm_assembly" link2="urdf_r_wrist_assembly" reason="Never"/>

    <!-- ===== Legs: collisions between leg links disabled (legs unused) ===== -->
    <!-- base/torso vs leg: keep adjacency/never so static legs don't false-collide with base -->
    <disable_collisions link1="urdf_base" link2="urdf_hip_assembly" reason="Adjacent"/>
    <disable_collisions link1="urdf_base" link2="urdf_hip_assembly_2" reason="Adjacent"/>
    <disable_collisions link1="urdf_base" link2="urdf_l_upper_femur_assembly" reason="Never"/>
    <disable_collisions link1="urdf_base" link2="urdf_r_upper_femur_assembly" reason="Never"/>
    <disable_collisions link1="urdf_base" link2="urdf_lower_femur_left_assembly" reason="Never"/>
    <disable_collisions link1="urdf_base" link2="urdf_lower_femur_right_assembly" reason="Never"/>
    <disable_collisions link1="urdf_simplified_torso" link2="urdf_hip_assembly" reason="Never"/>
    <disable_collisions link1="urdf_simplified_torso" link2="urdf_hip_assembly_2" reason="Never"/>
    <!-- all leg-leg pairs (66) -->
    <disable_collisions link1="urdf_hip_assembly" link2="urdf_l_upper_femur_assembly" reason="Legs unused"/>
    <disable_collisions link1="urdf_hip_assembly" link2="urdf_lower_femur_left_assembly" reason="Legs unused"/>
    <disable_collisions link1="urdf_hip_assembly" link2="urdf_l_tibia_assembly" reason="Legs unused"/>
    <disable_collisions link1="urdf_hip_assembly" link2="urdf_ankle_assembly" reason="Legs unused"/>
    <disable_collisions link1="urdf_hip_assembly" link2="urdf_foot_assembly" reason="Legs unused"/>
    <disable_collisions link1="urdf_hip_assembly" link2="urdf_hip_assembly_2" reason="Legs unused"/>
    <disable_collisions link1="urdf_hip_assembly" link2="urdf_r_upper_femur_assembly" reason="Legs unused"/>
    <disable_collisions link1="urdf_hip_assembly" link2="urdf_lower_femur_right_assembly" reason="Legs unused"/>
    <disable_collisions link1="urdf_hip_assembly" link2="urdf_r_tibia_assembly" reason="Legs unused"/>
    <disable_collisions link1="urdf_hip_assembly" link2="urdf_ankle_assembly_2" reason="Legs unused"/>
    <disable_collisions link1="urdf_hip_assembly" link2="urdf_foot_assembly_2" reason="Legs unused"/>
    <disable_collisions link1="urdf_l_upper_femur_assembly" link2="urdf_lower_femur_left_assembly" reason="Legs unused"/>
    <disable_collisions link1="urdf_l_upper_femur_assembly" link2="urdf_l_tibia_assembly" reason="Legs unused"/>
    <disable_collisions link1="urdf_l_upper_femur_assembly" link2="urdf_ankle_assembly" reason="Legs unused"/>
    <disable_collisions link1="urdf_l_upper_femur_assembly" link2="urdf_foot_assembly" reason="Legs unused"/>
    <disable_collisions link1="urdf_l_upper_femur_assembly" link2="urdf_hip_assembly_2" reason="Legs unused"/>
    <disable_collisions link1="urdf_l_upper_femur_assembly" link2="urdf_r_upper_femur_assembly" reason="Legs unused"/>
    <disable_collisions link1="urdf_l_upper_femur_assembly" link2="urdf_lower_femur_right_assembly" reason="Legs unused"/>
    <disable_collisions link1="urdf_l_upper_femur_assembly" link2="urdf_r_tibia_assembly" reason="Legs unused"/>
    <disable_collisions link1="urdf_l_upper_femur_assembly" link2="urdf_ankle_assembly_2" reason="Legs unused"/>
    <disable_collisions link1="urdf_l_upper_femur_assembly" link2="urdf_foot_assembly_2" reason="Legs unused"/>
    <disable_collisions link1="urdf_lower_femur_left_assembly" link2="urdf_l_tibia_assembly" reason="Legs unused"/>
    <disable_collisions link1="urdf_lower_femur_left_assembly" link2="urdf_ankle_assembly" reason="Legs unused"/>
    <disable_collisions link1="urdf_lower_femur_left_assembly" link2="urdf_foot_assembly" reason="Legs unused"/>
    <disable_collisions link1="urdf_lower_femur_left_assembly" link2="urdf_hip_assembly_2" reason="Legs unused"/>
    <disable_collisions link1="urdf_lower_femur_left_assembly" link2="urdf_r_upper_femur_assembly" reason="Legs unused"/>
    <disable_collisions link1="urdf_lower_femur_left_assembly" link2="urdf_lower_femur_right_assembly" reason="Legs unused"/>
    <disable_collisions link1="urdf_lower_femur_left_assembly" link2="urdf_r_tibia_assembly" reason="Legs unused"/>
    <disable_collisions link1="urdf_lower_femur_left_assembly" link2="urdf_ankle_assembly_2" reason="Legs unused"/>
    <disable_collisions link1="urdf_lower_femur_left_assembly" link2="urdf_foot_assembly_2" reason="Legs unused"/>
    <disable_collisions link1="urdf_l_tibia_assembly" link2="urdf_ankle_assembly" reason="Legs unused"/>
    <disable_collisions link1="urdf_l_tibia_assembly" link2="urdf_foot_assembly" reason="Legs unused"/>
    <disable_collisions link1="urdf_l_tibia_assembly" link2="urdf_hip_assembly_2" reason="Legs unused"/>
    <disable_collisions link1="urdf_l_tibia_assembly" link2="urdf_r_upper_femur_assembly" reason="Legs unused"/>
    <disable_collisions link1="urdf_l_tibia_assembly" link2="urdf_lower_femur_right_assembly" reason="Legs unused"/>
    <disable_collisions link1="urdf_l_tibia_assembly" link2="urdf_r_tibia_assembly" reason="Legs unused"/>
    <disable_collisions link1="urdf_l_tibia_assembly" link2="urdf_ankle_assembly_2" reason="Legs unused"/>
    <disable_collisions link1="urdf_l_tibia_assembly" link2="urdf_foot_assembly_2" reason="Legs unused"/>
    <disable_collisions link1="urdf_ankle_assembly" link2="urdf_foot_assembly" reason="Legs unused"/>
    <disable_collisions link1="urdf_ankle_assembly" link2="urdf_hip_assembly_2" reason="Legs unused"/>
    <disable_collisions link1="urdf_ankle_assembly" link2="urdf_r_upper_femur_assembly" reason="Legs unused"/>
    <disable_collisions link1="urdf_ankle_assembly" link2="urdf_lower_femur_right_assembly" reason="Legs unused"/>
    <disable_collisions link1="urdf_ankle_assembly" link2="urdf_r_tibia_assembly" reason="Legs unused"/>
    <disable_collisions link1="urdf_ankle_assembly" link2="urdf_ankle_assembly_2" reason="Legs unused"/>
    <disable_collisions link1="urdf_ankle_assembly" link2="urdf_foot_assembly_2" reason="Legs unused"/>
    <disable_collisions link1="urdf_foot_assembly" link2="urdf_hip_assembly_2" reason="Legs unused"/>
    <disable_collisions link1="urdf_foot_assembly" link2="urdf_r_upper_femur_assembly" reason="Legs unused"/>
    <disable_collisions link1="urdf_foot_assembly" link2="urdf_lower_femur_right_assembly" reason="Legs unused"/>
    <disable_collisions link1="urdf_foot_assembly" link2="urdf_r_tibia_assembly" reason="Legs unused"/>
    <disable_collisions link1="urdf_foot_assembly" link2="urdf_ankle_assembly_2" reason="Legs unused"/>
    <disable_collisions link1="urdf_foot_assembly" link2="urdf_foot_assembly_2" reason="Legs unused"/>
    <disable_collisions link1="urdf_hip_assembly_2" link2="urdf_r_upper_femur_assembly" reason="Legs unused"/>
    <disable_collisions link1="urdf_hip_assembly_2" link2="urdf_lower_femur_right_assembly" reason="Legs unused"/>
    <disable_collisions link1="urdf_hip_assembly_2" link2="urdf_r_tibia_assembly" reason="Legs unused"/>
    <disable_collisions link1="urdf_hip_assembly_2" link2="urdf_ankle_assembly_2" reason="Legs unused"/>
    <disable_collisions link1="urdf_hip_assembly_2" link2="urdf_foot_assembly_2" reason="Legs unused"/>
    <disable_collisions link1="urdf_r_upper_femur_assembly" link2="urdf_lower_femur_right_assembly" reason="Legs unused"/>
    <disable_collisions link1="urdf_r_upper_femur_assembly" link2="urdf_r_tibia_assembly" reason="Legs unused"/>
    <disable_collisions link1="urdf_r_upper_femur_assembly" link2="urdf_ankle_assembly_2" reason="Legs unused"/>
    <disable_collisions link1="urdf_r_upper_femur_assembly" link2="urdf_foot_assembly_2" reason="Legs unused"/>
    <disable_collisions link1="urdf_lower_femur_right_assembly" link2="urdf_r_tibia_assembly" reason="Legs unused"/>
    <disable_collisions link1="urdf_lower_femur_right_assembly" link2="urdf_ankle_assembly_2" reason="Legs unused"/>
    <disable_collisions link1="urdf_lower_femur_right_assembly" link2="urdf_foot_assembly_2" reason="Legs unused"/>
    <disable_collisions link1="urdf_r_tibia_assembly" link2="urdf_ankle_assembly_2" reason="Legs unused"/>
    <disable_collisions link1="urdf_r_tibia_assembly" link2="urdf_foot_assembly_2" reason="Legs unused"/>
    <disable_collisions link1="urdf_ankle_assembly_2" link2="urdf_foot_assembly_2" reason="Legs unused"/>

    <!-- ===== Left hand (adjacent + near) ===== -->
    <disable_collisions link1="urdf_l_wrist_assembly" link2="left_hand_base_link" reason="Adjacent"/>
    <disable_collisions link1="left_hand_base_link" link2="left_thumb_proximal_base" reason="Adjacent"/>
    <disable_collisions link1="left_hand_base_link" link2="left_thumb_proximal" reason="Adjacent"/>
