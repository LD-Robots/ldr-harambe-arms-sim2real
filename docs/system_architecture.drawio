<mxCell id="n153" value="&lt;b style=&quot;font-size:11px;color:#42285a&quot;&gt;materials · gazebo_extensions&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:8px;color:#666666;font-family:Courier New&quot;&gt;visual colours + gz sensor/plugin tags&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#42285a;dashed=0;arcSize=5;strokeWidth=1.3;fontFamily=Helvetica;spacing=3;spacingLeft=7;spacingRight=6;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1156" y="2494" width="534" height="74" as="geometry"/></mxCell>
<mxCell id="n154" value="&lt;b style=&quot;font-size:11px;color:#42285a&quot;&gt;camera.xacro · depth_camera.xacro&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:8px;color:#666666;font-family:Courier New&quot;&gt;RGB + depth sensor macros&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#42285a;dashed=0;arcSize=5;strokeWidth=1.3;fontFamily=Helvetica;spacing=3;spacingLeft=7;spacingRight=6;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1706" y="2494" width="534" height="74" as="geometry"/></mxCell>
<mxCell id="n155" value="&lt;b style=&quot;font-size:11px;color:#42285a&quot;&gt;use_sim switch&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:8px;color:#666666;font-family:Courier New&quot;&gt;true→Gazebo plugin · false→EtherCAT &amp;lt;ec_module&amp;gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#42285a;dashed=0;arcSize=5;strokeWidth=1.3;fontFamily=Helvetica;spacing=3;spacingLeft=7;spacingRight=6;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="2256" y="2494" width="534" height="74" as="geometry"/></mxCell>
<mxCell id="n156" value="&lt;b style=&quot;font-size:11px;color:#42285a&quot;&gt;xacro args&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:8px;color:#666666;font-family:Courier New&quot;&gt;pvt_mode·readonly·gravcomp·ankle_driver v1/v2&lt;br&gt;fixed_legs·only_left&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#42285a;dashed=0;arcSize=5;strokeWidth=1.3;fontFamily=Helvetica;spacing=3;spacingLeft=7;spacingRight=6;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="2806" y="2494" width="534" height="74" as="geometry"/></mxCell>
<mxCell id="n157" value="&lt;b&gt;SIM-TO-REAL CONTRACT&lt;/b&gt;&amp;nbsp;&amp;nbsp; identical ros2_control graph &amp;amp; &lt;b&gt;hardware_interface::SystemInterface&lt;/b&gt; — only the hardware plugin changes via &lt;b&gt;use_sim&lt;/b&gt;.&amp;nbsp;&amp;nbsp; Pipeline:&amp;nbsp; Isaac Gym/Lab (domain-randomised PD) ⟶ ONNX policy ⟶ Gazebo validation ⟶ Real hardware.&amp;nbsp;&amp;nbsp; Gap priority: PD-mismatch ▸ actuator-lag ▸ friction ▸ latency ▸ obs-normalisation." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7e6;strokeColor=#d79b00;fontColor=#5a3d00;dashed=0;arcSize=3;strokeWidth=2;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="2610" width="3320" height="48" as="geometry"/></mxCell>
<mxCell id="n158" value="§ 06A · SIMULATION PATH   (use_sim:=true)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#4d9b94;dashed=0;verticalAlign=top;align=left;fontColor=#4d9b94;fontFamily=Courier New;fontSize=15;fontStyle=1;spacingLeft=12;spacingTop=8;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="2682" width="1610" height="636" as="geometry"/></mxCell>
<mxCell id="n159" value="&lt;b style=&quot;color:#4d9b94;font-size:11px;letter-spacing:1px&quot;&gt;HOW IT CONNECTS&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#3a3a34;line-height:1.35&quot;&gt;Gazebo loads the gz_ros2_control plugin, which presents the SAME hardware_interface::SystemInterface that controller_manager expects — so identical controllers run. ros_gz_bridge mirrors /clock, sensors and TF between Gazebo and ROS. Physics (DART) closes the loop: commands move sim joints, sim encoders/IMU/camera feed state back. dual_arm_isaac is an alternate physics backend via an Isaac joint-state bridge.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fbfbf7;strokeColor=#4d9b94;fontColor=#3a3a34;dashed=0;arcSize=3;strokeWidth=1;fontFamily=Helvetica;spacing=4;spacingLeft=9;spacingRight=9;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="56" y="2722" width="1578" height="86" as="geometry"/></mxCell>
<mxCell id="n160" value="HARDWARE ABSTRACTION (sim)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#4d9b94;strokeColor=#4d9b94;fontColor=#ffffff;fontFamily=Courier New;fontSize=11;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=9;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="56" y="2814" width="1578" height="24" as="geometry"/></mxCell>
