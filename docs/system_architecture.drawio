<mxCell id="n39" value="§ 02 · APPLICATION  ·  MOTION PLANNING (MoveIt 2)  ·  LEARNING (RL)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#d79b00;dashed=0;verticalAlign=top;align=left;fontColor=#d79b00;fontFamily=Courier New;fontSize=15;fontStyle=1;spacingLeft=12;spacingTop=8;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="610" width="3320" height="420" as="geometry"/></mxCell>
<mxCell id="n40" value="&lt;b style=&quot;color:#d79b00;font-size:11px;letter-spacing:1px&quot;&gt;WHAT THIS LAYER DOES&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#3a3a34;line-height:1.35&quot;&gt;Turns goals into joint trajectories. MoveIt 2&amp;#x27;s move_group plans collision-free paths (OMPL / Pilz) and solves IK (KDL), then streams them to the controllers as a FollowJointTrajectory action via the simple-controller-manager. In parallel, the learning path trains a balancing/locomotion policy in Isaac Gym/Lab, exports it to ONNX, and deploys it through harambe_policy_controller — the same actuator PD model is used in sim and on hardware.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fbfbf7;strokeColor=#d79b00;fontColor=#3a3a34;dashed=0;arcSize=3;strokeWidth=1;fontFamily=Helvetica;spacing=4;spacingLeft=9;spacingRight=9;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="56" y="652" width="3288" height="60" as="geometry"/></mxCell>
<mxCell id="n41" value="MoveIt 2  ·  move_group + 5 config packages + MTC" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d79b00;strokeColor=#d79b00;fontColor=#ffffff;fontFamily=Courier New;fontSize=11;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=9;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="56" y="722" width="2036" height="24" as="geometry"/></mxCell>
<mxCell id="n42" value="REINFORCEMENT LEARNING  ·  sim-to-real policy" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#9673a6;strokeColor=#9673a6;fontColor=#ffffff;fontFamily=Courier New;fontSize=11;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=9;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="2108" y="722" width="1236" height="24" as="geometry"/></mxCell>
