<mxCell id="n183" value="&lt;b style=&quot;font-size:11px;color:#333333&quot;&gt;CiA 402 PDO byte-map  (MyActuator RMD X V4 · 16 B)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#666666;font-family:Courier New&quot;&gt;RxPDO 0x1600 master→drive:&lt;br&gt; 0x6040 ctrl_word · 0x607A target_pos(factor·rad→cnt, offset) · 0x60FF target_vel · 0x6071 target_torque(‰ rated-I) · 0x6072 max_torque · 0x6060 mode_op · pad&lt;br&gt;TxPDO 0x1A00 drive→master:&lt;br&gt; 0x6041 status_word · 0x6064 pos · 0x606C vel · 0x6077 torque · 0x603F error · 0x6061 mode_disp · pad&lt;br&gt;PVT 22 B adds Rx 0x2000 Kp / 0x2001 Kd · Tx 0x2009 motor_temp / 0x200C drive_temp / 0x200A bus_V&lt;br&gt;SDO@boot: 0x6072 max_torque(500=50%) · 0x60C2 interp 10 ms(100 Hz)/1 ms(PVT) · assign_activate 0x0300&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#333333;dashed=0;arcSize=5;strokeWidth=1.3;fontFamily=Helvetica;spacing=3;spacingLeft=7;spacingRight=6;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1716" y="2998" width="880" height="150" as="geometry"/></mxCell>
