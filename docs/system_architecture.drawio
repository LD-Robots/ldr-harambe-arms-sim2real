<mxCell id="n68" value="&lt;b style=&quot;font-size:11px;color:#5f4d00&quot;&gt;RTPS / DDS wire&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:8px;color:#666666;font-family:Courier New&quot;&gt;UDP + shared-memory (Iceoryx)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#5f4d00;dashed=0;arcSize=5;strokeWidth=1.3;fontFamily=Helvetica;spacing=3;spacingLeft=7;spacingRight=6;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="56" y="1416" width="300" height="42" as="geometry"/></mxCell>
